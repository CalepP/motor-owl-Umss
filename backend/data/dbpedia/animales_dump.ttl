<http://dbpedia.org/resource/Kangaroo>
  a owl:NamedIndividual, dbo:Animal ;
  rdfs:label "Canguro"@es ;
  rdfs:label "Kangaroo"@en ;
  rdfs:label "Kangourou"@fr ;
  rdfs:label "Canguru"@pt ;
  rdfs:label "Echte Kängurus"@de ;
  dbo:abstract "El Kangaroo era un transporte blindado de tropa de la Segunda Guerra Mundial. Creado por los canadienses a partir de los chasis de distintos carros de combate como el Ram o el Churchill. Pronto fue adoptado también por los británicos por su buena maniobrabilidad para acompañar a los carros de combate."@es ;
  foaf:depiction <http://commons.wikimedia.org/wiki/Special:FilePath/Kangaroo_Australia_01_11_2008_-_retouch.jpg?width=300> .

<http://dbpedia.org/resource/Koala>
