  dbo:abstract "Edward Emily Gibbon fue un historiador británico, considerado como el primer historiador moderno y uno de los historiadores más influyentes de todos los tiempos."@es ;
  foaf:depiction <http://commons.wikimedia.org/wiki/Special:FilePath/Hylobates_lar_-_Kaeng_Krachan_WB.jpg?width=300> .

<http://dbpedia.org/resource/Bonobo>
  a owl:NamedIndividual, dbo:Animal ;
